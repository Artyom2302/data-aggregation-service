# Тестовые значения для локальной разработки: база из docker-compose.yaml.
# Не используйте их вне локального окружения.
CONFIG_PATH=./config/config.yaml

POSTGRES_DB=data_package_service
POSTGRES_USER=data_package_service
POSTGRES_PASSWORD=data_package_service

DSN_URL=postgres://data_package_service:data_package_service@localhost:5432/data_package_service?sslmode=disable
